name: Build Aimbot App & Server

on:
  push:
    branches: [ main ]
  pull_request:
    branches: [ main ]

jobs:
  build-android:
    runs-on: ubuntu-latest
    
    steps:
    - name: Checkout repository
      uses: actions/checkout@v4

    - name: Set up JDK 17
      uses: actions/setup-java@v3
      with:
        java-version: '17'
        distribution: 'temurin'
        cache: gradle

    - name: Grant execute permission for gradlew
      run: chmod +x ./gradlew

    - name: Build Android App (APK)
      run: ./gradlew assembleDebug

    - name: Upload APK Artifact
      uses: actions/upload-artifact@v3
      with:
        name: aimbot-app-debug
        path: app/build/outputs/apk/debug/app-debug.apk

  setup-python-server:
    runs-on: ubuntu-latest
    
    steps:
    - name: Checkout repository
      uses: actions/checkout@v4

    - name: Set up Python
      uses: actions/setup-python@v4
      with:
        python-version: '3.9'

    - name: Install dependencies
      run: |
        pip install opencv-python numpy socket

    - name: Verify Server Script
      run: |
        echo "Verifying aimbot_server.py syntax..."
        python -m py_compile aimbot_server.py
        echo "✅ Python server script is valid."

    - name: Upload Server Script as Artifact
      uses: actions/upload-artifact@v3
      with:
        name: aimbot-server-script
        path: aimbot_server.py
